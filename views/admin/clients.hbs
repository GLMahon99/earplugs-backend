


  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3">Listado de Usuarios</h1>
      <a href="/users/add" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Nuevo Usuario
      </a>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead class="table-dark">
              <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {{#each usuarios}}
                <tr>
                  <td>{{@index}}</td>
                  <td>{{this.nombre}}</td>
                  <td>{{this.email}}</td>
                  <td>{{this.rol}}</td>
                  <td>
                    <a href="/users/{{this.id}}" class="btn btn-sm btn-info text-white">
                      <i class="bi bi-eye"></i> Ver
                    </a>
                    <a href="/users/edit/{{this.id}}" class="btn btn-sm btn-warning">
                      <i class="bi bi-pencil-square"></i> Editar
                    </a>
                    <form action="/users/delete/{{this.id}}" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que quieres eliminar este usuario?');">
                        <i class="bi bi-trash"></i> Eliminar
                      </button>
                    </form>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="5" class="text-center text-muted">No hay usuarios registrados</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

